void main()
{

    {
    string g = AddGeom("FUSELAGE","");
    SetGeomName(g,"Fuselage");
    SetParmVal(g,"Length","Design",25.6700);
    SetParmVal(g,"X_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",0.0000);
    Update();
    string xs = GetXSecSurf(g,0);
    // grow to 8 stations
    while (GetNumXSec(xs) < 8) { InsertXSec(g, 1, XS_ELLIPSE); Update(); }
    for (int i=0;i<GetNumXSec(xs);i++) ChangeXSecShape(xs,i,XS_ELLIPSE);
    Update();
    { string x = GetXSec(xs,0);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.0000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),0.9750);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),1.2300); }
    { string x = GetXSec(xs,1);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.0400);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),2.7300);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),2.8700); }
    { string x = GetXSec(xs,2);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.1500);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),3.7050);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),3.6900); }
    { string x = GetXSec(xs,3);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.3000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),3.9000);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),4.1000); }
    { string x = GetXSec(xs,4);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.4500);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),3.7050);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),3.8950); }
    { string x = GetXSec(xs,5);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.6200);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),2.4180);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),2.8700); }
    { string x = GetXSec(xs,6);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.8200);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),1.2480);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),1.8450); }
    { string x = GetXSec(xs,7);
      SetParmVal(GetXSecParm(x,"XLocPercent"),1.0000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),0.3120);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),0.8200); }
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"Wing");
    SetParmVal(g,"Span","XSec_1",15.5000);
    SetParmVal(g,"Root_Chord","XSec_1",5.2800);
    SetParmVal(g,"Tip_Chord","XSec_1",3.1250);
    SetParmVal(g,"Sweep","XSec_1",3.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.1500);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.1500);
    SetParmVal(g,"X_Rel_Location","XForm",7.0000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",-1.2000);
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"HTail");
    SetParmVal(g,"Span","XSec_1",4.6650);
    SetParmVal(g,"Root_Chord","XSec_1",2.6000);
    SetParmVal(g,"Tip_Chord","XSec_1",2.2000);
    SetParmVal(g,"Sweep","XSec_1",0.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.0900);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.0900);
    SetParmVal(g,"X_Rel_Location","XForm",22.3000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",0.4000);
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"Fin");
    SetParmVal(g,"Span","XSec_1",4.0000);
    SetParmVal(g,"Root_Chord","XSec_1",4.0000);
    SetParmVal(g,"Tip_Chord","XSec_1",2.0000);
    SetParmVal(g,"Sweep","XSec_1",35.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.0900);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.0900);
    SetParmVal(g,"X_Rel_Location","XForm",21.0000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",0.6000);
    SetParmVal(g,"X_Rel_Rotation","XForm",90.0);
    SetParmVal(g,"Sym_Planar_Flag","Sym",0);
    Update();
    }


    Update();
    ComputeCompGeom(SET_ALL,false,0);
    string rid = FindLatestResultsID("Comp_Geom");
    array<string> names = GetStringResults(rid,"Comp_Name");
    array<double> wet = GetDoubleResults(rid,"Wet_Area");
    array<double> th = GetDoubleResults(rid,"Theo_Area");
    for (int i=0;i<int(names.size());i++) Print("WET|"+names[i]+"|"+th[i]+"|"+wet[i]);
    WriteVSPFile("/workspace/analysis/AER-3783/vsp/express-2000.vsp3", SET_ALL);
}