void main()
{

    {
    string g = AddGeom("FUSELAGE","");
    SetGeomName(g,"Fuselage");
    SetParmVal(g,"Length","Design",20.2800);
    SetParmVal(g,"X_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",0.0000);
    Update();
    string xs = GetXSecSurf(g,0);
    // grow to 8 stations
    while (GetNumXSec(xs) < 8) { InsertXSec(g, 1, XS_ELLIPSE); Update(); }
    for (int i=0;i<GetNumXSec(xs);i++) ChangeXSecShape(xs,i,XS_ELLIPSE);
    Update();
    { string x = GetXSec(xs,0);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.0000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),0.3670);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),0.4300); }
    { string x = GetXSec(xs,1);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.0700);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),2.2020);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),2.7950); }
    { string x = GetXSec(xs,2);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.2000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),3.4865);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),4.0850); }
    { string x = GetXSec(xs,3);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.3800);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),3.6700);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),4.3000); }
    { string x = GetXSec(xs,4);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.5500);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),3.1195);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),3.6550); }
    { string x = GetXSec(xs,5);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.7500);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),1.8350);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),2.3650); }
    { string x = GetXSec(xs,6);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.9200);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),0.9175);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),1.5050); }
    { string x = GetXSec(xs,7);
      SetParmVal(GetXSecParm(x,"XLocPercent"),1.0000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),0.4404);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),0.6450); }
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"Wing");
    SetParmVal(g,"Span","XSec_1",14.6650);
    SetParmVal(g,"Root_Chord","XSec_1",4.5800);
    SetParmVal(g,"Tip_Chord","XSec_1",2.9400);
    SetParmVal(g,"Sweep","XSec_1",10.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.1500);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.1500);
    SetParmVal(g,"X_Rel_Location","XForm",6.0000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",-1.3000);
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"HTail");
    SetParmVal(g,"Span","XSec_1",5.5000);
    SetParmVal(g,"Root_Chord","XSec_1",3.3300);
    SetParmVal(g,"Tip_Chord","XSec_1",2.1700);
    SetParmVal(g,"Sweep","XSec_1",0.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.1200);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.1200);
    SetParmVal(g,"X_Rel_Location","XForm",17.0000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",4.0000);
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"Fin");
    SetParmVal(g,"Span","XSec_1",3.6000);
    SetParmVal(g,"Root_Chord","XSec_1",5.3000);
    SetParmVal(g,"Tip_Chord","XSec_1",3.6000);
    SetParmVal(g,"Sweep","XSec_1",35.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.1000);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.1000);
    SetParmVal(g,"X_Rel_Location","XForm",15.0000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",0.6000);
    SetParmVal(g,"X_Rel_Rotation","XForm",90.0);
    SetParmVal(g,"Sym_Planar_Flag","Sym",0);
    Update();
    }


    Update();
    ComputeCompGeom(SET_ALL,false,0);
    string rid = FindLatestResultsID("Comp_Geom");
    array<string> names = GetStringResults(rid,"Comp_Name");
    array<double> wet = GetDoubleResults(rid,"Wet_Area");
    array<double> th = GetDoubleResults(rid,"Theo_Area");
    for (int i=0;i<int(names.size());i++) Print("WET|"+names[i]+"|"+th[i]+"|"+wet[i]);
    WriteVSPFile("/workspace/analysis/AER-3783/vsp/prescott-pusher.vsp3", SET_ALL);
}