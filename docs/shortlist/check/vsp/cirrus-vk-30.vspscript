void main()
{

    {
    string g = AddGeom("FUSELAGE","");
    SetGeomName(g,"Fuselage");
    SetParmVal(g,"Length","Design",26.0000);
    SetParmVal(g,"X_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",0.0000);
    Update();
    string xs = GetXSecSurf(g,0);
    // grow to 8 stations
    while (GetNumXSec(xs) < 8) { InsertXSec(g, 1, XS_ELLIPSE); Update(); }
    for (int i=0;i<GetNumXSec(xs);i++) ChangeXSecShape(xs,i,XS_ELLIPSE);
    Update();
    { string x = GetXSec(xs,0);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.0000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),0.4300);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),0.4500); }
    { string x = GetXSec(xs,1);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.0700);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),2.5800);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),2.9250); }
    { string x = GetXSec(xs,2);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.2000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),4.0850);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),4.2750); }
    { string x = GetXSec(xs,3);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.3800);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),4.3000);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),4.5000); }
    { string x = GetXSec(xs,4);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.5500);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),3.6550);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),3.8250); }
    { string x = GetXSec(xs,5);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.7500);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),2.1500);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),2.4750); }
    { string x = GetXSec(xs,6);
      SetParmVal(GetXSecParm(x,"XLocPercent"),0.9200);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),1.0750);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),1.5750); }
    { string x = GetXSec(xs,7);
      SetParmVal(GetXSecParm(x,"XLocPercent"),1.0000);
      SetParmVal(GetXSecParm(x,"Ellipse_Width"),0.5160);
      SetParmVal(GetXSecParm(x,"Ellipse_Height"),0.6750); }
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"Wing");
    SetParmVal(g,"Span","XSec_1",19.3300);
    SetParmVal(g,"Root_Chord","XSec_1",4.1400);
    SetParmVal(g,"Tip_Chord","XSec_1",2.0700);
    SetParmVal(g,"Sweep","XSec_1",2.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.1400);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.1400);
    SetParmVal(g,"X_Rel_Location","XForm",9.0000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",-0.5000);
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"HTail");
    SetParmVal(g,"Span","XSec_1",4.5000);
    SetParmVal(g,"Root_Chord","XSec_1",2.5000);
    SetParmVal(g,"Tip_Chord","XSec_1",1.6000);
    SetParmVal(g,"Sweep","XSec_1",0.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.1000);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.1000);
    SetParmVal(g,"X_Rel_Location","XForm",22.0000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",-0.6000);
    Update();
    }


    {
    string g = AddGeom("WING","");
    SetGeomName(g,"Fin");
    SetParmVal(g,"Span","XSec_1",4.5000);
    SetParmVal(g,"Root_Chord","XSec_1",4.2000);
    SetParmVal(g,"Tip_Chord","XSec_1",2.0000);
    SetParmVal(g,"Sweep","XSec_1",35.000);
    SetParmVal(g,"Dihedral","XSec_1",0.000);
    SetParmVal(g,"ThickChord","XSecCurve_0",0.1000);
    SetParmVal(g,"ThickChord","XSecCurve_1",0.1000);
    SetParmVal(g,"X_Rel_Location","XForm",21.0000);
    SetParmVal(g,"Y_Rel_Location","XForm",0.0000);
    SetParmVal(g,"Z_Rel_Location","XForm",0.6000);
    SetParmVal(g,"X_Rel_Rotation","XForm",90.0);
    SetParmVal(g,"Sym_Planar_Flag","Sym",0);
    Update();
    }


    Update();
    ComputeCompGeom(SET_ALL,false,0);
    string rid = FindLatestResultsID("Comp_Geom");
    array<string> names = GetStringResults(rid,"Comp_Name");
    array<double> wet = GetDoubleResults(rid,"Wet_Area");
    array<double> th = GetDoubleResults(rid,"Theo_Area");
    for (int i=0;i<int(names.size());i++) Print("WET|"+names[i]+"|"+th[i]+"|"+wet[i]);
    WriteVSPFile("/workspace/analysis/AER-3783/vsp/cirrus-vk-30.vsp3", SET_ALL);
}